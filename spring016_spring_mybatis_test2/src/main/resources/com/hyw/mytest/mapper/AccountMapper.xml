<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--映射文件,专门写sql语句的文件,映射成对象-->
<mapper namespace="com.hyw.mytest.mapper.AccountMapper">
    <select id="selectAccount" resultType="Account">
        select id,act_no,balance from t_act where act_no = #{actNo}
    </select>
    <update id="updataAccount">
        update t_act set balance = #{balance} where act_no = #{actNo}
    </update>

</mapper>